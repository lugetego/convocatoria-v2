{% extends 'base.html.twig' %}

{% block nav %}
    <li class="nav-item active"><a class="nav-link" href="{{ path('registro_index') }}">Registros</a></li>
{% endblock %}

{% block navr %}
    <li class="nav-item active"><a class="nav-link" href="{{ path('app_logout') }}">Logout</a></li>
{% endblock %}

{% block body %}

<div class="container pt-4 pb-5">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin') }}">Solicitudes</a></li>
            <li class="breadcrumb-item"><a href="{{ path('registro_show', {'id': registro.id}) }}">Solicitud número {{ registro.id }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Evaluación</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h1 class="h3 mb-0"><i class="fa-solid fa-square-check text-primary me-2"></i>{{ registro.nombre|title ~ ' ' ~ registro.paterno|title ~ ' ' ~ registro.materno|title }}</h1>
    </div>

    {{ form_start(form, {'action': path('form_eval', {'id': registro.id}), 'method': 'post'}) }}

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h2 class="h6 mb-0">Evaluación</h2>
            </div>
            <div class="card-body p-4">
                <div class="mb-1 fw-semibold">Seleccionado</div>
                <div class="d-flex gap-2">
                    {% for child in form.activo %}
                        {{ form_widget(child, {'attr': {'class': 'btn-check'}}) }}
                        {{ form_label(child, null, {'label_attr': {'class': 'btn btn-outline-secondary'}}) }}
                    {% endfor %}
                </div>
                {{ form_errors(form.activo) }}
            </div>
        </div>

        {{ form_rest(form) }}

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-2"></i>Guardar</button>
            <a href="{{ path('registro_show', {'id': registro.id}) }}" class="btn btn-outline-secondary">Cancelar</a>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
