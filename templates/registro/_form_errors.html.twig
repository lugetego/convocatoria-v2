{% block form_errors %}
    <div class="container">
        {% if errors|length > 0 %}
            <ul>
                {% for error in errors %}
                    <p class="text-danger"><i class="fa-solid fa-xmark"></i> {{ error.message }}</p>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock form_errors %}
